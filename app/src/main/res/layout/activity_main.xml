<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical">

    <!-- ===== 顶部工具栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/topbar_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/btn_secondary"
                android:contentDescription="后退"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_secondary"
                android:contentDescription="前进"
                android:src="@android:drawable/ic_media_next"
                android:tint="#FFFFFF" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:background="@drawable/edittext_dark"
                android:hint="输入小说网址"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#66FFFFFF"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnGo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/btn_secondary"
                android:contentDescription="前往"
                android:src="@android:drawable/ic_menu_send"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <EditText
            android:id="@+id/etBookName"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edittext_dark"
            android:drawableStart="@android:drawable/ic_menu_edit"
            android:drawablePadding="8dp"
            android:drawableTint="#8899BB"
            android:hint="📖 书名（作为 TXT 文件名）"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#66FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 抓取状态提示 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#331B2A4A"
        android:gravity="center"
        android:padding="6dp"
        android:text="就绪"
        android:textColor="#9FB3D9"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- ===== 内置浏览器 ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100"
            android:progressTint="#3D5AFE" />
    </FrameLayout>

    <!-- ===== 底部操作栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottombar_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnGrab"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:background="@drawable/btn_primary"
            android:text="⚡ 一键抓取整章"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnFinish"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_secondary"
            android:contentDescription="打开 TXT"
            android:src="@android:drawable/ic_menu_save"
            android:tint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
